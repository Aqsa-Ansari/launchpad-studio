# ---- Required for real runs -------------------------------------------------
OPENAI_API_KEY=sk-...

# ---- Models (any OpenAI chat model your account can use) --------------------
LAUNCHPAD_MODEL=gpt-4o-mini            # worker agents
LAUNCHPAD_MANAGER_MODEL=gpt-4o         # hierarchical manager + final editor
LAUNCHPAD_JUDGE_MODEL=gpt-4o-mini      # LLM-as-judge guardrail + intake

# ---- Web search (optional; first key found wins: Tavily, then Serper) -------
TAVILY_API_KEY=
SERPER_API_KEY=
# With neither key set, agents use a built-in offline sample-data search tool.

# ---- Switches ---------------------------------------------------------------
LAUNCHPAD_MOCK=0                 # 1 = scripted fake LLM: zero cost, exercises all the plumbing
LAUNCHPAD_PLANNING=0             # 1 = let CrewAI's planner agent pre-plan Crew A
LAUNCHPAD_VERBOSE=0              # 1 = CrewAI console logs
LAUNCHPAD_USE_KNOWLEDGE=0        # 1 = also load knowledge/ as a CrewAI knowledge source (uses embeddings)
LAUNCHPAD_MAX_SEARCHES=24        # tool-level guardrail: search budget per run
LAUNCHPAD_ALLOWED_DOMAINS=       # comma list; empty = any. Applied to tools that take a URL
CREWAI_DISABLE_TELEMETRY=true
